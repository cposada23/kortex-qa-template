# Paths excluded from ZIP snapshots created by scripts/snapshot.mjs.
# Same shape as .gitignore (one path/glob per line; # comments OK).
# Snapshots are for backup/disaster-recovery — these directories
# would bloat the ZIP or shouldn't leave the machine.

versions/
.git/
.cache/
node_modules/

# Credentials — NEVER snapshot (even though snapshots are local-only,
# they often end up in client-managed backup locations like Teams
# archives, so credentials must stay out)
client-secrets/
*.env
*.env.local
.secrets

# OS junk
.DS_Store
Thumbs.db
desktop.ini
